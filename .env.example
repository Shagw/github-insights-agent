# Copy this file to .env and fill in your values. .env is git-ignored.

# --- LLM provider: "groq" (default, generous free tier) or "gemini" ---
LLM_PROVIDER=groq

# --- Groq (recommended) ---
# One free key is plenty (free tier ~30 req/min, ~1000 req/day per account).
# Get one at https://console.groq.com/keys
GROQ_API_KEY=your-key-here
GROQ_MODEL=openai/gpt-oss-20b

# --- Gemini API keys (used only if LLM_PROVIDER=gemini) ---
GEMINI_API_KEY_1=your-key-here
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=

# --- GitHub personal access token (OPTIONAL) ---
# Without it: 60 requests/hour (unauthenticated).
# With it:    5000 requests/hour. Create one at:
#   https://github.com/settings/tokens  (no scopes needed for public data)
GITHUB_TOKEN=

# --- Model ---
GEMINI_MODEL=gemini-flash-latest

# --- API server ---
# API key clients must send as the X-API-Key header to call /chat.
# Leave empty for local dev to disable auth (a warning is logged).
API_KEY=

# Comma-separated list of browser origins allowed via CORS (for the React UI).
CORS_ORIGINS=http://localhost:5173

# --- Sessions / conversation memory ---
# Redis stores per-conversation history so follow-up questions resolve.
# If Redis is unreachable, the app falls back to an in-memory store.
REDIS_URL=redis://localhost:6379/0
SESSION_TTL=3600          # seconds a conversation stays alive since its last turn
MAX_HISTORY_TURNS=12      # max messages replayed to the model (bounds token cost)
