# Copy this file to .env and fill in your values. .env is git-ignored.

# --- Gemini API keys (add up to 5 for rotation to survive free-tier limits) ---
GEMINI_API_KEY_1=your-key-here
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=

# --- GitHub personal access token (OPTIONAL) ---
# Without it: 60 requests/hour (unauthenticated).
# With it:    5000 requests/hour. Create one at:
#   https://github.com/settings/tokens  (no scopes needed for public data)
GITHUB_TOKEN=

# --- Model ---
GEMINI_MODEL=gemini-flash-latest
